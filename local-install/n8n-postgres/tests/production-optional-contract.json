  "constraints": {
    "kd_audit.kd_audit_pkey": "PRIMARY KEY (id)",
    "kd_sources.kd_sources_pkey": "PRIMARY KEY (id)",
    "kd_candidates.kd_candidates_pkey": "PRIMARY KEY (id)",
    "kd_sources.kd_sources_status_check": "CHECK ((status = ANY (ARRAY['queued'::text, 'processing'::text, 'done'::text, 'failed'::text])))",
    "kd_audit.kd_audit_candidate_id_fkey": "FOREIGN KEY (candidate_id) REFERENCES kd_candidates(id)",
    "kd_sources.kd_sources_content_hash_key": "UNIQUE (content_hash)",
    "kd_sources.kd_sources_source_text_check": "CHECK (((length(source_text) >= 20) AND (length(source_text) <= 20000)))",
    "kd_sources.kd_sources_source_type_check": "CHECK ((source_type = ANY (ARRAY['email'::text, 'blog'::text, 'website'::text, 'employee'::text, 'other'::text])))",
    "kd_candidates.kd_candidates_answer_check": "CHECK (((length(answer) >= 10) AND (length(answer) <= 3000)))",
    "kd_candidates.kd_candidates_status_check": "CHECK ((status = ANY (ARRAY['pending'::text, 'approved'::text, 'rejected'::text, 'published'::text, 'revoked'::text])))",
    "kd_candidates.kd_candidates_question_check": "CHECK (((length(question) >= 10) AND (length(question) <= 500)))",
    "kd_candidates.kd_candidates_source_id_fkey": "FOREIGN KEY (source_id) REFERENCES kd_sources(id) ON DELETE RESTRICT",
    "kd_candidates.kd_candidates_risk_level_check": "CHECK ((risk_level = ANY (ARRAY['low'::text, 'medium'::text, 'high'::text])))",
    "kd_candidates.kd_candidates_publish_state_check": "CHECK ((publish_state = ANY (ARRAY['idle'::text, 'queued'::text, 'publishing'::text, 'published'::text, 'failed'::text, 'revoked'::text])))",
    "kd_candidates.kd_candidates_knowledge_type_check": "CHECK ((knowledge_type = ANY (ARRAY['fact'::text, 'process'::text, 'faq'::text])))",
    "kd_candidates.kd_candidates_source_id_fingerprint_key": "UNIQUE (source_id, fingerprint)"
  }
