# Copy to .env on the NEW test server. Empty secrets intentionally block startup.
# Generate fresh independent values; do not copy production credentials.
N8N_POSTGRES_USER=n8n
N8N_POSTGRES_DB=n8n
N8N_POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=

# Direct HTTP access for the first isolated test; adjust for the target URL/proxy.
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
N8N_PROXY_HOPS=0
GENERIC_TIMEZONE=Europe/Berlin

# Supply the approved public CA certificate separately (PEM, no private key).
# Relative paths resolve against this Compose directory.
N8N_CA_FILE=./certs/picturesoftRoot.crt
